#!/usr/bin/env python3
"""
news-stream: Configurable Filipino News Live Stream Finder
Interactive TUI mode (ani-cli style) + CLI mode
Uses only Python standard library - no external dependencies
"""

import urllib.request
import urllib.error
import urllib.parse
import json
import re
import sys
import subprocess
import os
import html
import configparser
import signal
from pathlib import Path
from datetime import datetime

# ─── ANSI COLORS & STYLES ────────────────────────────────────────────────────


class C:
    RESET = "\033[0m"
    BOLD = "\033[1m"
    DIM = "\033[2m"

    RED = "\033[31m"
    GREEN = "\033[32m"
    YELLOW = "\033[33m"
    BLUE = "\033[34m"
    MAGENTA = "\033[35m"
    CYAN = "\033[36m"
    WHITE = "\033[37m"

    BG_DARK = "\033[48;5;234m"

    LIVE = f"\033[31m{BOLD}● LIVE{RESET}"
    RECENT = f"\033[33m⏱{RESET}"
    PLAY = f"\033[32m▶{RESET}"


def c(color, text):
    return f"{color}{text}{C.RESET}"


# ─── SPINNER ──────────────────────────────────────────────────────────────────

import threading
import time as _time

class Spinner:
    FRAMES = '⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'

    def __init__(self, label):
        self.label    = label
        self._stop    = threading.Event()
        self._thread  = threading.Thread(target=self._spin, daemon=True)

    def _spin(self):
        i = 0
        while not self._stop.is_set():
            frame = self.FRAMES[i % len(self.FRAMES)]
            sys.stdout.write(f"\r  {c(C.CYAN, frame)}  {c(C.DIM, self.label)}      ")
            sys.stdout.flush()
            _time.sleep(0.1)
            i += 1

    def __enter__(self):
        self._thread.start()
        return self

    def __exit__(self, *_):
        self._stop.set()
        self._thread.join()
        sys.stdout.write('\r' + ' ' * 60 + '\r')
        sys.stdout.flush()

    def done(self, msg, color=C.GREEN):
        self._stop.set()
        self._thread.join()
        sys.stdout.write(f"\r  {c(color, '✓')}  {msg}" + ' ' * 40 + '\n')
        sys.stdout.flush()

    def fail(self, msg):
        self._stop.set()
        self._thread.join()
        sys.stdout.write(f"\r  {c(C.YELLOW, '⚠')}  {msg}" + ' ' * 40 + '\n')
        sys.stdout.flush()


