#!/usr/bin/env python3
"""
tune: Music preset player with fzf TUI
Drop-in replacement for play-url with news-stream-style interface.

Usage:
    tune                        Interactive TUI
    tune <preset|url> [opts]    Direct play (CLI mode)
    tune --list                 List presets
    tune --config               Edit config
    tune --help

Symlink support: ln -s $(which tune) ~/.local/bin/music/linkin-park
"""

import urllib.request
import urllib.error
import urllib.parse
import json
import html
import re
import sys
import subprocess
import os
import signal
import configparser
import tempfile
from pathlib import Path
from datetime import datetime
import threading
import socket as _socket
import time

# ─── ANSI ─────────────────────────────────────────────────────────────────────

class C:
    RESET   = "\033[0m"
    BOLD    = "\033[1m"
    DIM     = "\033[2m"
    RED     = "\033[31m"
    GREEN   = "\033[32m"
    YELLOW  = "\033[33m"
    BLUE    = "\033[34m"
    MAGENTA = "\033[35m"
    CYAN    = "\033[36m"
    WHITE   = "\033[37m"
    PLAY    = f"\033[32m▶\033[0m"
    STOPPED = f"\033[31m■\033[0m"
    SEARCH  = f"\033[33m🔍\033[0m"

def c(color, text):
    return f"{color}{text}{C.RESET}"

