#!/usr/bin/env python3
"""yt-cli — thin wrapper around yt_cli.

Dispatch depends on Path(sys.argv[0]).name (yt-cli → menu, music/<preset>
→ radio preset). Python preserves argv[0] as invoked, so this wrapper can
stay transparent. Symlink chains resolve for sys.path[0], so `import yt_cli`
works from ~/.local/bin/music/* → ../yt-cli → this file.
"""
from yt_cli import main

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\n\n👋 Goodbye!")
        raise SystemExit(0)
    except Exception as e:
        print(f"\n❌ Error: {e}")
        import traceback
        traceback.print_exc()
        raise SystemExit(1)
